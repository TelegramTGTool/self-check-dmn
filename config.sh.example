# Domain-check shell script configuration.
#
# Copy this to `config.sh` next to the scripts and edit values:
#     cp config.sh.example config.sh
#     chmod 600 config.sh

# Base URL of the dmnbot API, INCLUDING the /api prefix (no trailing slash).
# Laravel mounts routes/api.php under /api, so cron endpoints live at /api/cron/*.
#   Local Herd:  API_BASE="http://dmnbot.test/api"
#   Production:  API_BASE="https://your-dmnbot-host/api"

# Shared secret. Must match `CRON_API_KEY` in the Laravel .env on the API host.
CRON_API_KEY="change-me-to-a-long-random-string"

# Working directory for state files. Created if missing.
# Local macOS / dev (no sudo): leave commented — lib.sh uses tools/domain-check/data
# Linux production:
#   WORK_DIR="/var/lib/domain-check"
#   LOG_DIR="/var/log/domain-check"
# WORK_DIR="${SCRIPT_DIR}/data"
# LOG_DIR="${SCRIPT_DIR}/logs"

# Folder where finished domain files are archived (optional; defaults to ${WORK_DIR}/archive).
# ARCHIVE_DIR="${WORK_DIR}/archive"

# How many domains to process per `check-domains.sh` invocation.
BATCH_SIZE=300

# Slice of the full active-domain pool this instance fetches from the API
# (GET /cron/domain-list?offset=...&limit=...). Use this to run multiple
# checkers concurrently against the same pool without duplicating work —
# give each instance its own config.sh (and its own WORK_DIR) with a
# non-overlapping range, e.g.:
#   Instance A: FETCH_OFFSET=0   FETCH_LIMIT=300   (domains 1-300)
#   Instance B: FETCH_OFFSET=300 FETCH_LIMIT=300   (domains 301-600)
#   Instance C: FETCH_OFFSET=600                   (domain 601 to end)
# FETCH_LIMIT empty/unset = "to the end of the pool".
FETCH_OFFSET=0
FETCH_LIMIT=50

# Country pool this instance checks (GET /cron/domain-list?country=...).
# The checker probes from inside one country, so it must only be handed the
# merchants registered for that country. Known values come from
# config/merchants.php on the API host: Malaysia, Australia.
# Empty/unset = let the API use its own default (Malaysia).
# Note the country filter runs BEFORE offset/limit, so each country has its
# own pool numbered from 0 — don't carry offsets across countries.
FETCH_COUNTRY="Malaysia"

# Telco labels iterated in order. Edit if you only have a subset.
# These are the same labels stored in the API (uppercased).
TELCO_LIST=(DIGI CELCOM HOTLINK UMOBILE UNIFI)

# Cooldown (seconds) after a telco finishes a full pass — gives the operator
# time to swap SIM / switch network manually before the next telco starts.
SWITCH_COOLDOWN_SECONDS=10

# Identifier reported back to the API so you can tell probe boxes apart.
HOST_LABEL="$(hostname -s)"

# Curl options shared across all HTTP probes.
#
# Probes are HEAD requests that follow redirects and read only the final url +
# status — the page body is never downloaded. Domains like these serve ~800 KB
# single-page fronts, so this is the difference between ~320 MB and ~120 KB per
# full pass over the list.
CURL_TIMEOUT=2
CURL_CONNECT_TIMEOUT=2
CURL_MAX_REDIRECTS=2
# Status codes meaning "this server will not answer HEAD". The probe retries
# those once as GET with the body discarded, so a verdict never depends on
# HEAD support.
HEAD_FALLBACK_CODES="405 501"
# Bytes to read when checking for an ISP that serves its block notice INLINE at
# the original url (200, no redirect) instead of redirecting. 0 = disabled,
# which keeps every clean domain at header-only cost. 65536 is a sensible value
# if you find an ISP that does this — real block pages are tiny.
BLOCK_BODY_PROBE_BYTES=0

# Ping settings. Default = 5 probes, 2s wait per reply, packet loss threshold.
# PING_TIMEOUT is in SECONDS (lib.sh converts to ms on macOS for ping -W).
PING_COUNT=2
PING_TIMEOUT=2
# Block on packet loss >= this percent. Above 100 = disabled, which is the
# default: CDNs and firewalls drop ICMP wholesale, so a loss-based verdict
# marks large numbers of perfectly reachable hosts as blocked. Ping's job is
# reading the RESOLVED IP so a regulator DNS redirect to a sinkhole
# (MCMC_BLOCK_IPS) can be caught. Set to 100 to restore the old behaviour.
PING_LOSS_BLOCK_THRESHOLD=101

# MCMC block-detection patterns/IPs now live at the top of check-domains.sh
# (edit there directly, no config.sh change needed).

# How many domains to send per HTTP POST batch to /domain-block-report.
REPORT_BATCH_SIZE=100

# ----------------------------------------------------------------------------
# DataImpulse mobile proxy (check "is this domain blocked in <country>" from
# outside that country — no physical SIM required).
#
# When PROXY_ENABLED=1 every domain probe is tunnelled through the DataImpulse
# gateway instead of this box's own network. ICMP cannot traverse an HTTP or
# SOCKS proxy, so the ping stage is skipped in this mode and the verdict comes
# from how the HTTPS request fails at the exit node (see README).
# ----------------------------------------------------------------------------
PROXY_ENABLED=0

# Gateway. DataImpulse serves every plan from the same host; port 823 rotates
# the exit IP on each request, ports 10000-10500 are the sticky-session ports.
PROXY_SCHEME="http"                 # http | socks5h
PROXY_HOST="gw.dataimpulse.com"
PROXY_PORT=823

# Plan credentials. The mobile pool is a SEPARATE plan from residential — use
# the login/password shown for your MOBILE plan in the DataImpulse dashboard.
PROXY_USER=""
PROXY_PASS=""

# Targeting. DataImpulse takes these as `__key.value` suffixes on the username,
# e.g. <login>__cr.au__asn.1221. Leave a value empty to omit that param.
PROXY_COUNTRY="au"                  # __cr.<iso2>  — Australia

# Keep the DataImpulse exit in the country named by FETCH_COUNTRY. With this on,
# switching FETCH_COUNTRY is enough -- PROXY_COUNTRY follows and a stale value
# can no longer ask for an impossible combination like "__cr.my" on an
# Australian ASN, which matches no exit node and kills the batch on the
# pre-flight health check. Set to 0 to manage the two by hand.
PROXY_COUNTRY_FOLLOWS_FETCH=1
PROXY_CITY=""                       # __city.<name>, e.g. "sydney"
PROXY_ASN=""                        # __asn.<number>, e.g. 1221 (Telstra)

# Escape hatch: if your plan uses different targeting syntax, set the whole
# param string here and it is appended verbatim (PROXY_COUNTRY/CITY/ASN and
# the session params are then ignored).
# PROXY_USER_SUFFIX="__cr.au__mobile.true"

# rotating = a new exit IP per request (good for spreading a big domain list
# across many mobile IPs). sticky = one IP per telco pass, held for
# PROXY_SESSION_TTL minutes via __sessid/__sesstime.
PROXY_SESSION_MODE="rotating"
PROXY_SESSION_TTL=10

# Optional per-telco targeting: map each TELCO_LIST label to extra `__` params
# so one run can compare carriers. Entries here override PROXY_ASN/CITY above.
# For Australian mobile carriers:
#   TELCO_LIST=(TELSTRA OPTUS VODAFONE)
#   TELCO_PROXY_MAP=(
#       "TELSTRA=__asn.1221"
#       "OPTUS=__asn.4804"
#       "VODAFONE=__asn.133612"
#   )
TELCO_PROXY_MAP=()

# Timeouts for probes that go through the gateway. These are deliberately far
# more generous than CURL_TIMEOUT: a proxied request pays for the gateway
# CONNECT, TLS to the target, another TLS handshake per redirect hop, and the
# body download. If the total budget is too small, healthy sites that redirect
# or serve a heavy page come back as reason=timeout.
PROXY_CONNECT_TIMEOUT=10
PROXY_CURL_TIMEOUT=25

# Retries per domain before a failure is recorded as a verdict. Each retry
# draws a fresh exit IP in rotating mode, so a single bad mobile node does not
# become a false "blocked".
PROXY_MAX_RETRIES=2

# What an at-the-exit-node failure (DNS failure, TLS reset, refused connection,
# timeout) means. "blocked" mirrors the direct-mode ping_loss behaviour;
# "unknown" is the conservative choice if your target country has flaky mobile
# routes. Gateway-side failures (auth rejected, 407, gateway unreachable) are
# ALWAYS reported as unknown — never as blocked.
PROXY_UNREACHABLE_RESULT="blocked"

# ---- Verdict guards ---------------------------------------------------------
# How many of this session's in-country resolvers must independently return a
# regulator sinkhole before a domain is recorded blocked. The public open
# resolvers are largely consumer CPE boxes on dynamic IPs: measured 2026-09-08,
# only 2 of 29 healthy Malaysian resolvers were enforcing, and one that enforced
# earlier the same day had stopped. Requiring agreement means a single box that
# starts wildcarding cannot mark a whole batch blocked. Automatically lowered
# when fewer than this many resolvers answer, so detection never silently stops;
# the CHECK evidence carries agree=N/M so any verdict can be audited.
DNS_BLOCK_QUORUM=2

# Verify a bare 403/451 against this box's OWN direct connection before calling
# it a block. 403 counts as a block only because an ACMA-blocked site answers
# the in-country exit with 403 while serving everyone else normally -- nothing
# checked that at runtime, so a site that refuses EVERYBODY (bot protection,
# dead origin) was recorded as blocked. Measured 2026-09-08: 7signs.com returns
# 403 to Australia and 200 elsewhere (a real block), while imperium777.com
# returns 403 to every vantage (not a block at all).
#
# The control never leaves this instance's country assignment -- it is this
# box's own connection, not another country's exit. If the control gets no
# status at all the original verdict stands, so a flaky local link cannot erase
# a real block.
PROXY_BLOCK_CODE_CONTROL=1

# HTTP status codes that count as a block when the probe goes through the proxy.
# 451 is the explicit legal one. 403 is included because an ACMA-blocked site
# answers the AU exit with a bare 403 while serving the identical request fine
# from elsewhere. Space-separated; set to "451" alone to disable the 403 rule.
# Note: 403 is also what a WAF/bot filter returns, so a domain marked http_403
# is worth eyeballing once before acting on it.
PROXY_BLOCK_HTTP_CODES="451 403"

# Pre-flight guards, run once per batch before any domain is probed.
# If either fails the batch is skipped with the pointer untouched, so a dead or
# wrong-country session can never mark the whole list as blocked.
PROXY_CONTROL_DOMAIN="www.google.com"
PROXY_VERIFY_COUNTRY=1
PROXY_IP_CHECK_URL="http://ip-api.com/json/?fields=status,countryCode,query,as"

# Cooldown between telcos in proxy mode. The exit node switches instantly, so
# the manual SIM-swap wait in SWITCH_COOLDOWN_SECONDS does not apply and this
# value replaces it whenever PROXY_ENABLED=1.
PROXY_SWITCH_COOLDOWN_SECONDS=5

# ---- Regulator DNS stage (proxy mode) ---------------------------------------
# MCMC enforces its blocklist at the Malaysian ISP resolvers. The DataImpulse
# gateway resolves names at its own infrastructure (Google DNS, Singapore)
# before traffic ever reaches the Malaysian mobile exit, so a proxied fetch
# sees the live site even for a sinkholed domain — verified across 40 distinct
# exits on AS4818 / AS9534 / AS38466 / AS10030.
#
# With this on, the domain is resolved from THIS host and matched against
# MCMC_BLOCK_IPS, while the proxy still carries the HTTP probe with its
# per-telco ASN targeting. REQUIRES this machine to sit on a Malaysian ISP.
#
# NOTE: the verdict comes from this host's resolver, so every telco in
# TELCO_LIST returns the same blocked/ok answer. TELCO_PROXY_MAP still governs
# which ASN carries the fetch, but it does not differentiate the verdict.
PROXY_LOCAL_DNS_CHECK=1

# Pin a specific resolver for that stage (e.g. "1.1.1.1" to disable the signal,
# or a known Malaysian resolver). Empty = this machine's system resolver.
PROXY_DNS_RESOLVER=""

# ---- Automatic in-country resolver discovery (discover-resolvers.sh) ---------
# a.sh runs discover-resolvers.sh before every scan. It maps FETCH_COUNTRY to an
# ISO code, pulls that country's public resolver list, and keeps the ones that
# are actually enforcing the regulator blocklist right now. The sinkhole address
# is LEARNED, not configured: a regulator points every blocked name at one IP,
# so an address an in-country resolver returns for several unrelated domains --
# while 8.8.8.8 returns something different for each -- can only be a sinkhole.
#
# The result lands in ${WORK_DIR}/resolvers.session as DNS_SESSION_RESOLVERS /
# DNS_SESSION_SINKHOLES. lib.sh loads that file and, when it is populated, pins
# PROXY_DNS_RESOLVER, turns PROXY_LOCAL_DNS_CHECK on and adds the learned
# sinkholes to MCMC_BLOCK_IPS. That lifts the old "must sit on a Malaysian ISP"
# requirement above -- the resolver being queried is in-country, this box need
# not be. With discovery off or unsuccessful, everything above applies unchanged.
DNS_DISCOVERY_ENABLED=1

# Override the FETCH_COUNTRY -> ISO 3166-1 alpha-2 mapping (e.g. "my", "au").
# Empty = derive it from FETCH_COUNTRY.
DNS_COUNTRY_ISO=""

# How hard discovery works each run. Defaults are tuned for a fast pre-scan
# pass; raise DNS_MAX_CANDIDATES if a country's public resolvers are flaky.
DNS_SAMPLE_DOMAINS=8        # domains sampled from this instance's own list
DNS_MAX_CANDIDATES=120      # resolvers health-checked per run
DNS_PROBE_RESOLVERS=12      # healthy resolvers actually probed for a blocklist
DNS_KEEP_RESOLVERS=4        # enforcing resolvers kept for the scan
DNS_SINKHOLE_MIN_HITS=3     # distinct domains that must share one bogus IP

# A CDN also answers differently in-country, so a candidate sinkhole is dropped
# unless it either serves nothing at all (a blackhole, as in Malaysia) or serves
# something that reads like a regulator notice (as in Australia, where it
# redirects to acma.gov.au). Set to 0 to accept any repeated bogus address.
DNS_SINKHOLE_VERIFY=1

# Global public resolvers (Cloudflare, Google, Quad9, OpenDNS, AdGuard...) get
# listed under every country but are not in-country ISP resolvers, and some of
# them filter on their own policy rather than the regulator's list. Regex of
# resolver IPs discovery skips.
DNS_EXCLUDE_RESOLVERS="^(1\\.0\\.0\\.|1\\.1\\.1\\.|8\\.8\\.|8\\.26\\.|9\\.9\\.9|149\\.112\\.|208\\.67\\.2|94\\.140\\.1|76\\.76\\.2|185\\.228\\.16)"

